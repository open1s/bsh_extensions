{
  "description": "Inspect the display and pointer, then capture a screenshot",
  "input_schema": {
    "type": "object",
    "properties": {
      "path": { "type": "string", "description": "Optional screenshot path" }
    },
    "additionalProperties": false
  },
  "steps": [
    { "name": "display", "tool": "computer", "arguments": { "action": "screen_size" } },
    { "name": "pointer", "tool": "computer", "arguments": { "action": "cursor_position" } },
    { "name": "capture", "tool": "computer", "arguments": { "action": "screenshot", "path": "{{input.path}}" } }
  ]
}