{
  "title": "Extension DevKit",
  "icon": null,
  "location": "right",
  "default_visibility": "visible",
  "view": {
    "schema_version": "1.0",
    "root": {
      "type": "column",
      "children": [
        {
          "type": "heading",
          "text": "Extension DevKit",
          "level": 2
        },
        {
          "type": "markdown",
          "text": "Scaffold, validate, lint, hash, smoke-test, package and publish BSH extensions. The buttons below dispatch back into `server.py`; **Run self-check** lints this very package and returns a fresh card."
        },
        {
          "type": "table",
          "columns": [
            "Tool",
            "What it answers"
          ],
          "rows": [
            [
              "scaffold",
              "a package that already validates"
            ],
            [
              "validate",
              "will the host load this?"
            ],
            [
              "lint",
              "will a reader trust it?"
            ],
            [
              "check",
              "both, plus the hash"
            ],
            [
              "smoke",
              "do the tools actually run?"
            ],
            [
              "explain",
              "what does the standard say?"
            ],
            [
              "market",
              "is the index entry current?"
            ],
            [
              "package",
              "is the release archive reproducible?"
            ]
          ]
        },
        {
          "type": "divider"
        },
        {
          "type": "button",
          "label": "Run self-check",
          "action": "selfcheck",
          "style": "primary"
        },
        {
          "type": "button",
          "label": "Reference topics",
          "action": "topics"
        },
        {
          "type": "button",
          "label": "Refresh",
          "action": "refresh"
        }
      ]
    }
  }
}
